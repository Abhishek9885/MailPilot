  },
  "dependencies": {
    "@mailpilot/shared": "0.1.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.18.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.2",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.1.17"
  }
}
