# Copy this file to .env. All values below are local development placeholders.
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

API_PORT=4000
TRUST_PROXY_HOPS=0
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:56379
# Shared local HMAC signing secret for server-to-server Express to FastAPI calls.
AI_SERVICE_TOKEN=local-development-ai-service-token-change-before-use
AI_SERVICE_TIMEOUT_MS=120000
GOOGLE_OIDC_CLIENT_ID=local-google-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=local-development-only-google-client-secret
GOOGLE_GMAIL_OAUTH_CLIENT_ID=local-gmail-oauth-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_OAUTH_CLIENT_SECRET=local-development-only-gmail-oauth-client-secret
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=local-calendar-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=local-development-only-calendar-oauth-client-secret
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=local-replace-with-base64-encoded-32-byte-key
GOOGLE_CALENDAR_EVENTS_ENABLED=false
GMAIL_TOKEN_ENCRYPTION_KEY=local-replace-with-base64-encoded-32-byte-key
SESSION_SECRET=local-development-session-secret-change-before-use
SESSION_TTL_SECONDS=28800

AI_PORT=8000
AI_HOST=127.0.0.1
AI_LOG_LEVEL=info
# Local only. Production AI must use a separately permissioned database role.
AI_DATABASE_URL=postgresql://mailpilot:local_dev_only@localhost:55432/mailpilot?schema=public
# Optional; defaults to apps/ai/artifacts/email-tfidf-logreg-v1.
# AI_CLASSIFIER_ARTIFACT_DIR=./artifacts/email-tfidf-logreg-v1
AI_SERVICE_NAME=ai
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=gpt-6.1-sol
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_RETRIES=2
AI_LLM_MAX_RETRY_DELAY_SECONDS=8
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_TIMEOUT_SECONDS=30
AI_EMBEDDING_MAX_RETRIES=2
AI_EMBEDDING_MAX_RETRY_DELAY_SECONDS=8
OPENAI_API_KEY=local-placeholder-replace-with-your-openai-api-key
# Optional estimated cost reporting; configure all three from a dated rate card.
# AI_LLM_INPUT_PRICE_USD_PER_MTOK=
# AI_LLM_CACHED_INPUT_PRICE_USD_PER_MTOK=
# AI_LLM_OUTPUT_PRICE_USD_PER_MTOK=
# AI_LLM_PRICING_VERSION=
# Optional embedding cost estimate; configure both from a dated rate card.
# AI_EMBEDDING_INPUT_PRICE_USD_PER_MTOK=
# AI_EMBEDDING_PRICING_VERSION=

POSTGRES_DB=mailpilot
POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://mailpilot:local_dev_only@localhost:55432/mailpilot?schema=public
